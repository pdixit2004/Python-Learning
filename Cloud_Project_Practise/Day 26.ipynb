   "source": [
    "def decorator(function):\n",
    "    def wrapper():\n",
    "        print(\"Before Function\")\n",
    "        function()\n",
    "        print(\"After Function\")\n",
    "    return wrapper\n",
    "\n",
    "def greet():\n",
    "    print(\"Hello\")\n",
    "\n",
    "greet = decorator(greet)\n",
    "greet()"
   ]
  }
